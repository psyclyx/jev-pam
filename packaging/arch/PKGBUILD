# Maintainer: psyclyx <me@psyclyx.xyz>
pkgname=jev-pam
pkgver=0.1.0
pkgrel=1
pkgdesc="PAM module that asks Jev"
arch=('x86_64' 'aarch64')
url="https://github.com/psyclyx/jev-pam"
license=('MIT')
depends=('glibc' 'pam' 'ca-certificates')
makedepends=('zig>=0.16')
install=jev-pam.install

_root="$startdir/../.."

_zig() {
  zig build "$@" --release=safe -Dcpu=baseline \
    --cache-dir "$srcdir/zig-cache" --global-cache-dir "$srcdir/zig-global-cache"
}

build() {
  cd "$_root"
  _zig --prefix "$srcdir/out"
}

check() {
  cd "$_root"
  _zig test
}

package() {
  cd "$_root"
  DESTDIR="$pkgdir" _zig install --prefix /usr
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
